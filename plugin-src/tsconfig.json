{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "lib": [
      "ES2020"
    ],
    "types": [],
    "typeRoots": [
      "../node_modules/@figma"
    ]
  },
  "include": [
    "*.ts",
    "../shared/*.ts",
    "../node_modules/@figma/plugin-typings/index.d.ts"
  ],
  "exclude": [
    "*.test.ts"
  ]
}
