{
  "name": "AppFlow",
  "id": "local-agent-bridge",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma",
    "figjam"
  ],
  "documentAccess": "dynamic-page",
  "enablePrivatePluginApi": true,
  "networkAccess": {
    "allowedDomains": [
      "none"
    ],
    "devAllowedDomains": [
      "ws://localhost:3055",
      "http://localhost:3055"
    ],
    "reasoning": "Talks to the appflow MCP server on this machine only."
  },
  "permissions": [
    "currentuser",
    "teamlibrary"
  ]
}
